# Copy to .env and edit. NEVER commit .env. All values below are SYNTHETIC / development only.
DEBUG=true
SECRET_KEY=dev-only-change-me-please-0123456789abcdef0123456789abcdef
ALLOWED_HOSTS=localhost,127.0.0.1
DATA_DIR=
# Interoperability / device API key (sent as X-API-Key header)
INTEROP_API_KEY=dev-interop-key-change-me
# HMAC key used to sign offline update packages
UPDATE_SIGNING_KEY=dev-update-signing-key-change-me
# Password given to demo users by `manage.py seed_demo` (synthetic)
DEMO_PASSWORD=Demo#12345
# Runtime behaviour (can also be overridden in Admin > Settings)
RFID_MODE=mock
LMS_ONLINE=true
LOAN_DAYS=14
RENEW_DAYS=14
MAX_RENEWALS=2
FINE_PER_DAY=1.00
FINE_LIMIT=50.00
GATE_ALERT_EMAIL=security@library.example
